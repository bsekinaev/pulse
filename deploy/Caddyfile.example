# Вариант A: Caddy на хосте
pulse.bsekinaev.ru {
    encode zstd gzip
    reverse_proxy 127.0.0.1:18120
}

# Вариант B: Caddy в Docker — использовать вместо A, только если
# Caddy и контейнер pulse-demo подключены к одной Docker-сети.
# pulse.bsekinaev.ru {
#     encode zstd gzip
#     reverse_proxy pulse-demo:8000
# }
