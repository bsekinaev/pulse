# Скопируйте в .env и замените значения. НЕ коммитьте секреты.
APP_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_СЕКРЕТ_НЕ_МЕНЕЕ_32_СИМВОЛОВ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ_НЕ_МЕНЕЕ_12_СИМВОЛОВ

# Только точный IP Caddy на pulse_public_edge, НЕ вся подсеть 172.20.0.0/16.
# Перед production-пуском закрепить этот адрес в Compose Caddy и проверить XFF.
# PULSE_TRUSTED_PROXY_CIDRS=172.20.0.3/32
